# Collected market data and the prediction log. Regenerable, and the prediction
# audit record is personal to a run, so it is not committed.
*.db
*.db-journal
*.db-wal
*.db-shm

# Output from an unattended collect/predict/settle session. Regenerable, and it
# is a record of one machine's run rather than part of the project.
.session-run.log

# Credentials
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
# Windows refuses to unlink pytest's default temp symlink, so runs here use
# --basetemp=.pytest-tmp instead of the system temp directory.
.pytest-tmp/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# OS
Thumbs.db
desktop.ini
.DS_Store
