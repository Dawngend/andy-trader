# Andy Trader configuration. No API keys anywhere in this file on purpose:
# every venue is a keyless public endpoint and nothing here can place an order.

# Where the append-only observation and prediction store lives. Relative paths
# resolve against the repository root.
CRYPTO_DB_PATH=crypto_observations.db

CRYPTO_INSTRUMENTS=BTC-USD,ETH-USD
CRYPTO_INTERVALS=1h,4h
CRYPTO_HORIZONS=1h,4h

# Backtests charge both values once on entry and once on exit. Ten basis points
# is the venue fee assumption; five basis points models adverse fill movement.
CRYPTO_BACKTEST_FEE_BPS=10
CRYPTO_BACKTEST_SLIPPAGE_BPS=5

# Bybit gives full OHLCV at 1h and 4h; CoinGecko gives close and volume only but
# has never been DNS-blocked in testing, so it is the fallback. Exchange domains
# are INTERMITTENTLY blocked on some Philippine ISPs: on 2026-09-04 Kraken and
# Bybit resolved to a block-page box, then resolved normally twenty minutes
# later on the same machine. Failures land as degraded rows by design, so a pass
# reporting degraded rows is usually the network rather than the code.
# "coinbase" and "kraken" are also implemented and tested.
CRYPTO_VENUES=bybit,coingecko

# A scheduled pass already retries the whole collection 15 minutes later.
# One bounded attempt avoids a hung source outliving that cadence.
CRYPTO_COLLECTOR_TIMEOUT_SECONDS=8
CRYPTO_COLLECTOR_RETRIES=1
CRYPTO_COLLECTOR_BACKOFF_SECONDS=1
CRYPTO_COLLECTOR_RATE_LIMIT_SECONDS=1

# Live calls abstain when the newest reference close is older than this. The
# 90-minute ceiling tolerates one delayed hourly bar without silently turning a
# nominal 1h forecast into a prediction from data that is several hours old.
CRYPTO_MAX_DATA_AGE_MINUTES=90
